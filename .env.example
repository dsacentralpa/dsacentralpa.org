# Copy to .env for the Python import script.
# For the Worker itself, use `npx wrangler secret put NAME` instead — never commit keys.
# For local `wrangler dev`, put the same values in .dev.vars (also gitignored).

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+17372324091
# Set only after the A2P campaign is approved and attached to a Messaging Service:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Guards /api/admin/* — generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Used by scripts/import_list.py to build confirmation links and email copy.
SITE_URL=https://dsacentralpa.org
CHAPTER_NAME=Central PA DSA
CONTACT_EMAIL=info@dsacentralpa.org
FROM_EMAIL=Central PA DSA <info@dsacentralpa.org>
